rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if logged in user is either Jit or Saini (supports primary and couple emails)
    function isCouple() {
      return request.auth != null && (
        request.auth.token.email.lower() in [
          'jithazra00@gmail.com',
          'sainipaul000@gmail.com',
          'hers.jit@gmail.com',
          'his.saini.gulu@gmail.com'
        ]
      );
    }

    // Public Memory Details (Photos) - Anyone can view, only couple can modify
    match /Public_Memory_Details/{docId} {
      allow read: if true;
      allow write: if isCouple();
    }

    // Music Details (Songs) - Anyone can view, only couple can modify
    match /Music_Details/{docId} {
      allow read: if true;
      allow write: if isCouple();
    }

    // Private Memory Details - Strictly restricted to authenticated couple
    match /Private_Memory_Details/{docId} {
      allow read, write: if isCouple();
    }

    // Legacy memories store (backward compatibility)
    match /memories/{docId} {
      allow read: if true;
      allow write: if isCouple();
    }

    // Public Stats - Anyone can read, only couple can write (or handle increments safely)
    match /Public_Stats/{docId} {
      allow read: if true;
      allow write: if isCouple();
    }

    // Activity Logs & Actions - Track added/deleted images and songs
    match /Activity_Logs/{docId} {
      allow read, write: if isCouple();
    }

    // Deny access by default to any unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}